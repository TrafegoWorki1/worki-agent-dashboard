# Variaveis de ambiente do Worki Agent Dashboard.
# Copie para .env.local e preencha com valores reais.
# NUNCA commite .env.local — ele esta no .gitignore.
#
# Todas as NEXT_PUBLIC_* sao inlinadas no bundle pelo Next no momento do
# build. Apenas URL e anon key podem ter esse prefixo, e isso e
# intencional: o banco nao tem RLS liberado para anon, entao elas nao
# concedem acesso a nada. Qualquer outra credencial com NEXT_PUBLIC_
# ficaria publica em "View Source" para sempre.

# --- Supabase: publico (inlinado no bundle) -------------------------
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-pública

# --- Supabase: servidor (nunca sai do container) --------------------
# Bypassa RLS. Por isso a autorizacao do painel e feita em
# src/lib/auth.ts, antes de qualquer consulta.
# PROIBIDO: criar NEXT_PUBLIC_SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role

# --- Controle de acesso --------------------------------------------
# Lista branca de e-mails, separados por virgula, sem espacos.
# Sem essa variavel NINGUEM entra no painel: e o que impede que
# qualquer conta criada no projeto do Supabase veja os dados.
DASHBOARD_ALLOWED_EMAILS=voce@seudominio.com,outro@seudominio.com

# --- EasyPanel: leitura de status ----------------------------------
# Token do MCP do painel. Leitura apenas: o dashboard mostra se o
# servico esta online, ultimo deploy e logs. Nao reinicia nem implanta.
EASYPANEL_URL=https://seu-painel.exemplo.com
EASYPANEL_API_TOKEN=seu-token-mcp

# --- Evolution (apenas leitura, opcional) ---------------------------
# NUNCA colocar no NEXT_PUBLIC_: e a chave que envia WhatsApp.
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=agent-domintante